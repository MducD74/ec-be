generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  PROCESSING
  PAID
  SHIPPED
  COMPLETED
  CANCELLED
}

enum InventoryStatus {
  AVAILABLE
  SOLD
}

enum ActionType {
  VIEW
  ADD_TO_CART
  PURCHASE
}

enum PaymentMethod {
  COD
  STRIPE
  VNPAY
  ONLINE
}

enum PaymentStatus {
  PENDING
}

enum Role {
  USER
  ADMIN
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model User {
  id           Int               @id @default(autoincrement())
  email        String            @unique
  password     String
  name         String?
  role         Role              @default(USER)
  orders       Order[]
  carts        Cart[]
  interactions UserInteraction[]
  recommendationCache RecommendationCache?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model Product {
  id           Int               @id @default(autoincrement())
  name         String
  description  String?
  specifications Json?
  price        Decimal
  sku          String            @unique
  imageUrl     String?
  categoryId   Int?
  category     Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  inventory    Inventory[]
  orderItems   OrderItem[]
  cartItems    CartItem[]
  interactions UserInteraction[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([categoryId])
}

model Category {
  id       Int        @id @default(autoincrement())
  name     String
  parentId Int?
  parent   Category? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
}

model Order {
  id            Int           @id @default(autoincrement())
  userId        Int
  voucherId     Int?
  total         Decimal
  discountAmount Float        @default(0)
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod @default(COD)
  paymentStatus PaymentStatus @default(PENDING)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  voucher       Voucher?      @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
  @@index([voucherId])
}

model Voucher {
  id               Int          @id @default(autoincrement())
  code             String       @unique
  description      String?
  discountType     DiscountType
  discountValue    Float
  minOrderValue    Float        @default(0)
  maxDiscountValue Float?
  startDate        DateTime
  endDate          DateTime
  usageLimit       Int
  usedCount        Int          @default(0)
  isActive         Boolean      @default(true)
  partnerId        String?
  orders           Order[]
}

model Inventory {
  id           Int             @id @default(autoincrement())
  productId    Int
  serialNumber String          @unique
  imei         String?         @unique
  status       InventoryStatus @default(AVAILABLE)
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItemId  Int?
  orderItem    OrderItem?      @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([productId])
  @@index([status])
  @@index([orderItemId])
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int?
  sessionId String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([userId])
  @@unique([sessionId])
  @@index([userId])
  @@index([sessionId])
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  productId Int
  quantity  Int      @default(1)
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
}

model OrderItem {
  id        Int         @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  unitPrice Decimal
  total     Decimal
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventory Inventory[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([orderId])
  @@index([productId])
}

model UserInteraction {
  id         Int        @id @default(autoincrement())
  userId     Int?
  productId  Int
  actionType ActionType
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())

  @@index([userId])
  @@index([productId])
  @@index([actionType])
}

model RecommendationCache {
  id                    Int      @id @default(autoincrement())
  userId                Int      @unique
  recommendedProductIds Json
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt             DateTime @updatedAt
}
