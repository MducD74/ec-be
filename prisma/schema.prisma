generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  CANCELLED
}

enum InventoryStatus {
  AVAILABLE
  SOLD
}

enum InteractionType {
  VIEW
  CART
  PURCHASE
}

model User {
  id           Int               @id @default(autoincrement())
  email        String            @unique
  password     String
  name         String?
  orders       Order[]
  carts        Cart[]
  interactions UserInteraction[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model Product {
  id           Int               @id @default(autoincrement())
  name         String
  description  String?
  price        Decimal
  sku          String            @unique
  inventory    Inventory[]
  orderItems   OrderItem[]
  cartItems    CartItem[]
  interactions UserInteraction[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model Order {
  id        Int         @id @default(autoincrement())
  userId    Int
  total     Decimal
  status    OrderStatus @default(PENDING)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
}

model Inventory {
  id           Int             @id @default(autoincrement())
  productId    Int
  serialNumber String          @unique
  imei         String?         @unique
  status       InventoryStatus @default(AVAILABLE)
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItemId  Int?
  orderItem    OrderItem?      @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([productId])
  @@index([status])
  @@index([orderItemId])
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int?
  sessionId String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([userId])
  @@unique([sessionId])
  @@index([userId])
  @@index([sessionId])
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  productId Int
  quantity  Int      @default(1)
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
}

model OrderItem {
  id        Int         @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  unitPrice Decimal
  total     Decimal
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventory Inventory[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([orderId])
  @@index([productId])
}

model UserInteraction {
  id        Int             @id @default(autoincrement())
  userId    Int?
  sessionId String?
  productId Int
  type      InteractionType
  score     Int
  user      User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@index([userId])
  @@index([sessionId])
  @@index([productId])
  @@index([type])
}
